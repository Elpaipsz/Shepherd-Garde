# ──────────────────────────────────────────────
# Shepherd Garde — .gitignore
# ──────────────────────────────────────────────

# CRITICAL: Environment files with secrets
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/
*.pyo
htmlcov/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml

# Django
*.log
local_settings.py
db.sqlite3
media/
staticfiles/

# Virtual environments
venv/
env/
.venv/
ENV/

# Node / Next.js
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/.env.local
frontend/.env.development.local
frontend/.env.test.local
frontend/.env.production.local
frontend/npm-debug.log*

# Docker volumes (not needed in repo)
postgres_data/

# IDEs
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db

# Scripts de datos de demo (legacy del Entregable 1)
scripts/

# Documentos binarios y PDFs académicos (no van en el repo de código)
*.docx
*.pdf
*.xlsx

# Archivos de presentación interna (guiones, etc.)
docs/PRESENTATION_GUIDE.md
docs/PRESENTATION_SCRIPT.md
docs/product*.md

# Embedded repos / submódulos no configurados
shepherd_admin_core/

# Scripts de arranque locales de Windows
*.bat
start_all.bat
